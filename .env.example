# Supabase public project credentials.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase Storage bucket used for project and profile files.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="pixel-project-files"

# Document storage provider. Keep Supabase by default; set to "s3" to route new uploads to Amazon S3.
DOCUMENT_STORAGE_PROVIDER="supabase"

# Amazon S3 document storage. Server-only; never prefix credentials with NEXT_PUBLIC_*.
AWS_REGION="us-east-1"
AWS_S3_BUCKET="YOUR_PRIVATE_DOCUMENT_BUCKET"
AWS_S3_PREFIX="pixel-project"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
# Optional limits for the document manager.
DOCUMENT_STORAGE_MAX_FILE_SIZE_MB="50"
DOCUMENT_STORAGE_ALLOWED_TYPES=""

# Server-only key used by admin API routes. Never expose it as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Public app URL used for invitation and password recovery redirects.
NEXT_PUBLIC_SITE_URL="https://YOUR_DOMAIN"

# GitHub App for software/Scrum projects. All values are server-only.
# Setup URL: https://YOUR_DOMAIN/api/github/install/callback
# Webhook URL: https://YOUR_DOMAIN/api/github/webhook
# OAuth callback: https://YOUR_DOMAIN/api/github/user/callback
GITHUB_APP_ID="YOUR_GITHUB_APP_ID"
GITHUB_APP_SLUG="your-github-app-slug"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\\nYOUR_KEY\\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="YOUR_LONG_RANDOM_WEBHOOK_SECRET"
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
GITHUB_STATE_SECRET="YOUR_SECOND_LONG_RANDOM_SECRET"
# Vercel uses this bearer secret for the daily evidence repair job.
CRON_SECRET="YOUR_THIRD_LONG_RANDOM_SECRET"
# Explicit workspace UUID for unattended GitHub webhooks/repair. Leave unset to disable them.
GITHUB_AUTOMATION_WORKSPACE_ID=""
# Optional. Pixel defaults to GitHub's stable 2022-11-28 API version.
GITHUB_API_VERSION="2022-11-28"

# Server-only platform administrators. Workspace owners do not gain platform access.
BOOTSTRAP_ADMIN_EMAILS="admin@example.com"

# Resend credentials used by server routes to send branded transactional emails.
# Public signup confirmations separately require custom SMTP in Supabase Auth.
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL="Pixel Project <notificaciones@pixelprojects.com.co>"

# PWA push notifications.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
WEB_PUSH_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
WEB_PUSH_SUBJECT="mailto:admin@example.com"
# Server-only HMAC secret (32+ characters) for push subscription integrity.
PUSH_SUBSCRIPTION_ATTESTATION_SECRET="YOUR_LONG_RANDOM_ATTESTATION_SECRET"
# Optional during secret rotation; remove after all active devices re-register.
PUSH_SUBSCRIPTION_ATTESTATION_PREVIOUS_SECRET=""

# reTerminal / ePaper 7.5" admin dashboard. Server-only; never prefix with NEXT_PUBLIC_*.
EPAPER_ADMIN_TOKEN="YOUR_LONG_RANDOM_DEVICE_TOKEN"
# Explicit workspace UUID for this unattended device; required when enabling the integration.
EPAPER_WORKSPACE_ID=""
# Optional comma-separated tokens if you later add more screens.
EPAPER_DEVICE_TOKENS=""
# Device polling cadence suggested by /api/epaper/admin-dashboard.json.
EPAPER_REFRESH_SECONDS="600"
